# ── App ──────────────────────────────────────────────
PORT=5000
NODE_ENV=development
# Frontend origin. Doubles as the Socket.io CORS origin (see src/sockets/trade.socket.js)
# in addition to the HTTP cors() allowlist.
CLIENT_URL=http://localhost:3000

# ── MongoDB ──────────────────────────────────────────
MONGODB_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/socialescrow

# ── JWT ──────────────────────────────────────────────
JWT_SECRET=your_super_secret_jwt_key_change_this
JWT_EXPIRES_IN=7d
REFRESH_TOKEN_SECRET=your_refresh_secret_change_this
JWT_REFRESH_EXPIRES_IN=30d

# ── Bcrypt ───────────────────────────────────────────
BCRYPT_ROUNDS=12

# ── Email (Nodemailer) ───────────────────────────────
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your@gmail.com
EMAIL_PASS=your_app_password
EMAIL_FROM=SocialEscrow <noreply@socialescrow.co.ke>

# ── Cloudinary ───────────────────────────────────────
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ── M-Pesa Daraja ────────────────────────────────────
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=your_consumer_key
MPESA_CONSUMER_SECRET=your_consumer_secret
MPESA_SHORTCODE=174379
MPESA_PASSKEY=your_passkey
MPESA_CALLBACK_URL=https://your-railway-url.railway.app/api/mpesa/webhook/stk-push

# Webhook source allowlist (comma-separated IPv4 addresses and/or CIDR blocks).
# Daraja callbacks are unsigned, so the source IP is the only origin check. REQUIRES
# TRUST_PROXY_HOPS to be correct (below) — otherwise req.ip is the Railway proxy.
# In production an EMPTY value fails CLOSED (all webhooks rejected). In non-production
# an empty value bypasses the check (dev/sandbox). VERIFY these against current
# Safaricom/Daraja egress ranges before production — they drift over time.
# Published Daraja production egress (verify before prod):
MPESA_ALLOWED_IPS=196.201.214.200,196.201.214.206,196.201.213.114,196.201.214.207,196.201.214.208,196.201.213.44,196.201.212.127,196.201.212.138,196.201.212.129,196.201.212.136,196.201.212.74,196.201.212.69

# Number of trusted proxy hops in front of the app (Express `trust proxy`).
# Railway's edge proxy = 1. Pin this to your proxy depth so a client-supplied
# X-Forwarded-For cannot spoof the source IP.
TRUST_PROXY_HOPS=1

# Independently re-query Daraja (STK Query) to confirm a callback before settling.
# Default true. Set to "false" ONLY for flaky sandbox testing — never in production.
MPESA_REQUIRE_QUERY_CONFIRM=true

# ── M-Pesa B2C (seller payouts, Phase 7) ─────────────
# Dispatch policy. "false" = every payout waits for an admin at
# PATCH /api/admin/payouts/:id/approve. Keep it false until B2C is proven in production;
# "true" makes escrow release disburse straight to the seller with no human in the loop.
AUTO_PAYOUT=false

# B2C paybill/till (the "Business Short Code" of your B2C product). This is NOT
# necessarily the same shortcode as MPESA_SHORTCODE above, which is the C2B collector.
MPESA_B2C_SHORTCODE=600000

# The API operator username configured on the B2C product in the Daraja portal
# (e.g. "testapi" on sandbox). Not your portal login.
MPESA_INITIATOR_NAME=your_initiator_name

# The initiator password AFTER RSA encryption with Safaricom's public certificate,
# base64-encoded. Pre-compute it once (openssl or the Daraja portal's
# "Security Credential" generator) and paste the result here — the app never derives it
# at runtime, never logs it, and never returns it in an API response. Treat it like a
# private key: rotate it if it ever lands in a log, a screenshot, or a git diff.
MPESA_SECURITY_CREDENTIAL=your_encrypted_security_credential

# Daraja posts the disbursement outcome to these. Must be public HTTPS URLs, and both
# are unsigned like every other Daraja callback — MPESA_ALLOWED_IPS is the only source
# check protecting them.
MPESA_B2C_RESULT_URL=https://your-railway-url.railway.app/api/mpesa/webhook/b2c-result
MPESA_B2C_TIMEOUT_URL=https://your-railway-url.railway.app/api/mpesa/webhook/b2c-timeout

# ── Redis / BullMQ ────────────────────────────────────
REDIS_URL=redis://127.0.0.1:6379

# ── Vault Encryption ─────────────────────────────────
# A random IV is generated per-encryption and stored with the ciphertext, so no
# static IV is configured.
VAULT_ENCRYPTION_KEY=32_char_hex_key_change_this_now_

# ── Anthropic / Claude Code ──────────────────────────
ANTHROPIC_BASE_URL=https://agentrouter.org/
ANTHROPIC_AUTH_TOKEN=your_anthropic_auth_token
ANTHROPIC_API_KEY=your_anthropic_api_key

# ── Platform ─────────────────────────────────────────
PLATFORM_FEE_PERCENT=6
PAYMENT_WINDOW_MINUTES=30
CONFIRM_WINDOW_HOURS=24
